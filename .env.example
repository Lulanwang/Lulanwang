# --- App ---
APP_ENV=development
APP_SECRET=change-me-please-32-bytes-minimum-aaaaaaaaaa
PUBLIC_BASE_URL=http://localhost

# --- JWT / Auth ---
JWT_SECRET=change-me-jwt-secret-32-bytes-minimum-bbbbbbbb
JWT_TTL_MINUTES=30

# --- Postgres ---
POSTGRES_USER=lulan
POSTGRES_PASSWORD=lulan_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
APP_DB=app
ORTHANC_DB=orthanc
DATABASE_URL=postgresql+psycopg://lulan:lulan_dev_password@postgres:5432/app

# --- Orthanc ---
ORTHANC_URL=http://orthanc:8042
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=orthanc_dev_password
ORTHANC_DICOMWEB_PREFIX=/dicom-web

# --- Artifacts ---
ARTIFACT_DIR=/data/artifacts

# --- AI ---
# Set to "false" to use real MONAI bundles (run `make seed-models` first)
MOCK_INFERENCE=true
MONAI_BUNDLE_DIR=/data/monai-bundles
# Optional: provide a path to torchvision densenet121 weights for the
# breast adapter; if unset, MockModel is used for mammography.
BREAST_MAMMO_WEIGHTS=

# --- MedGemma narrative writer ---
# "mock" (default): deterministic in-process template, no network egress.
# "hf": POST to a Hugging Face Inference Endpoint serving MedGemma.
#       Findings + study metadata leave the cluster — no pixel data, but
#       see COMPLIANCE.md for the BAA implications.
MEDGEMMA_BACKEND=mock
MEDGEMMA_MODEL_ID=google/medgemma-4b-it
MEDGEMMA_HF_ENDPOINT_URL=
MEDGEMMA_HF_TOKEN=
MEDGEMMA_MAX_NEW_TOKENS=512
MEDGEMMA_TIMEOUT_SECONDS=20

# --- De-identification ---
DEID_DATE_SHIFT_DAYS_MAX=90

# --- Demo seed credentials ---
SEED_ADMIN_EMAIL=admin@lulan.local
SEED_ADMIN_PASSWORD=admin_demo_password
SEED_CLINICIAN_EMAIL=clinician@lulan.local
SEED_CLINICIAN_PASSWORD=clinician_demo_password
